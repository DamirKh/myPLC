xedge.createloader(io)

local config = require("modules.config")
local ds = require("modules.ds18b20")
local sensor_manager = require("modules.sensor_manager")
local controller = require("modules.controller")
local schedule = require("modules.schedule")
local history_mod = require("modules.history")
local history_store = require("modules.history_store")
local live_buffer = require("modules.live_buffer")
local pump_runtime = require("modules.pump_runtime")
local mqtt_mod = require("modules.mqtt_bridge")
local rgb_led = require("modules.rgb_led")
local indicator = require("modules.indicator")
local pin_mod = require("modules.pin")

local cfg, loaded, load_err = config.load(io)
if not loaded then
   trace("thermostat: config load:", tostring(load_err))
end

local pin_key
if ba and ba.aeskey then
   local ok, key = pcall(ba.aeskey, 32)
   if ok then
      pin_key = key
   end
end

local csrf_key
if ba and ba.aeskey then
   local ok, key = pcall(ba.aeskey, 32)
   if ok then
      csrf_key = key
   end
end

local wifi_tpm_key
local function wifi_crypto_key()
   if wifi_tpm_key then
      return wifi_tpm_key
   end
   if not (ba and ba.tpm and ba.tpm.uniquekey) then
      return nil, "softTPM unavailable"
   end
   local ok, key = pcall(ba.tpm.uniquekey, "thermostat-wifi", 32)
   if not ok or not key then
      return nil, tostring(key)
   end
   wifi_tpm_key = key
   return key
end

local function encrypt_wifi_password(password)
   local key, err = wifi_crypto_key()
   if not key then
      return nil, err
   end
   local ok, value = pcall(ba.aesencode, key, password)
   if not ok or not value then
      return nil, tostring(value)
   end
   return value
end

local function decrypt_wifi_password(value)
   local key, err = wifi_crypto_key()
   if not key then
      return nil, err
   end
   local ok, password = pcall(ba.aesdecode, key, value)
   if not ok or not password then
      return nil, tostring(password)
   end
   return password
end

local pin_failures = {}

local function pin_is_configured()
   return cfg.security and cfg.security.pin_hash and "" ~= cfg.security.pin_hash
end

local ssr
local function ssr_write(on)
   if not ssr then
      return
   end
   local active_high = cfg.pins.ssr_active_high ~= false
   ssr:value(active_high == (on and true or false))
end

if esp32 and esp32.gpio then
   ssr = esp32.gpio(cfg.pins.ssr, "OUT")
   ssr_write(false)
end

local rgb
if cfg.pins.rgb_enabled ~= false then
   rgb = rgb_led.new(cfg.pins.rgb, { brightness = cfg.pins.rgb_brightness })
   if not rgb then
      trace("thermostat: rgb led unavailable")
   end
end

local sensor_mgr = sensor_manager.new(cfg)
local state = controller.new(cfg, os.time())
local room_hist = history_mod.new(math.max(1, math.floor(
   (cfg.history.room.retention_sec or 604800) / (cfg.history.room.sample_sec or 600))))
local pump_hist = history_mod.new(math.max(1, math.floor(
   (cfg.history.pump.retention_sec or 86400) / (cfg.history.pump.sample_sec or 180))))
local runtime = pump_runtime.new(0)
local live_buf = live_buffer.new(600)
local snapshot = sensor_mgr:snapshot(os.time())
local override = nil
local manual_pump = false
local manual_timer = nil
local service_mode = false
local scan_mode = false
local scan_requested = false
local scan_running = false
local scan_started = 0
local scan_result = nil
local scan_job_timer = nil
local sensor_busy = false
local wifi_connected = false
local wifi_sta_connected = false
local wifi_mode = nil
local wifi_ip = nil
local wifi_ap_client_seen = nil
local wifi_connect_deadline = nil
local wifi_switch_timer = nil
local wifi_last_error = nil
local led_tick = 0
local boot_until = os.time() + 2
local time_valid = os.time() > 1600000000
local mqtt_bridge = nil
local last_mqtt_publish = 0
local last_runtime_persist = 0
local last_set_target = 0
local pump_meter_state = false
local history_next_room = nil
local history_next_pump = nil

local function cancel_timer(timer)
   if timer then
      pcall(timer.cancel, timer)
   end
end

local function trim(text)
   return tostring(text or ""):match("^%s*(.-)%s*$")
end

local function node_id()
   if esp32 and esp32.mac then
      local mac = esp32.mac()
      return "xedge32_" .. (mac:gsub(".", function(c)
         return string.format("%02x", string.byte(c))
      end))
   end
   return "xedge32_thermostat"
end

local function build_state()
   local ready = config.control_ready(cfg)
   return {
      ok = true,
      ready = ready,
      pump = state.pump,
      mode = state.mode,
      target = state.target,
      base_target = cfg.control.target_room,
      setpoint_min = cfg.ui.public_setpoint_min,
      setpoint_max = cfg.ui.public_setpoint_max,
      override_active = override ~= nil and override.expires ~= nil and override.expires > os.time(),
      override_until = (override and override.expires and override.expires > os.time()) and override.expires or nil,
      floor_limit = cfg.control.floor_limit,
      room = snapshot.actual.room,
      floor = snapshot.actual.floor,
      supply = snapshot.actual.supply,
      return_temp = snapshot.actual.return_temp,
      pump_temp = snapshot.actual.pump,
      pump_hours = runtime:hours(),
      pump_seconds = runtime.seconds,
      faults = state.faults,
      warnings = state.warnings,
      sensors = snapshot.diagnostics,
      time = os.time(),
      time_valid = time_valid,
      utc_offset_minutes = cfg.schedule.utc_offset_minutes or 0,
      schedule_enabled = cfg.schedule.enabled,
      frost_enabled = cfg.control.frost_enabled,
      mqtt_enabled = cfg.mqtt.enabled,
      mqtt_connected = mqtt_bridge and mqtt_bridge.connected or false,
      wifi = wifi_connected,
      wifi_mode = wifi_mode,
      wifi_sta_connected = wifi_sta_connected,
      wifi_ip = wifi_ip,
      wifi_sta_ssid = cfg.wifi.sta_ssid or "",
      wifi_has_credentials = "" ~= (cfg.wifi.sta_ssid or "") and "" ~= (cfg.wifi.sta_password_enc or ""),
      wifi_ap_client_active = "ap" == wifi_mode and wifi_ap_client_seen ~= nil
         and (os.time() - wifi_ap_client_seen) < 30,
      wifi_last_error = wifi_last_error,
      led_tick = led_tick,
      pin_configured = pin_is_configured(),
      pin_available = pin_key ~= nil,
      service_mode = service_mode,
      scan_active = scan_mode or scan_requested or scan_running,
      last_reason = state.last_reason,
   }
end

local function publish_state_if_needed(force)
   if not mqtt_bridge or not mqtt_bridge.connected then
      return
   end
   local now = os.time()
   if force or now - last_mqtt_publish >= 30 then
      last_mqtt_publish = now
      mqtt_bridge:publish_state(build_state())
   end
end

local function apply_led()
   if not rgb then
      return
   end
   local color = indicator.frame({
      boot = os.time() < boot_until,
      fault = #state.faults > 0,
      service = service_mode or scan_mode,
      wifi = wifi_connected,
      wifi_mode = wifi_mode,
      wifi_sta_connected = wifi_sta_connected,
      wifi_ap_client_active = "ap" == wifi_mode and wifi_ap_client_seen ~= nil
         and (os.time() - wifi_ap_client_seen) < 30,
      pump = state.pump,
   }, led_tick)
   rgb:write(color)
end

local function apply_control()
   local now = os.time()
   time_valid = now > 1600000000
   local override_target = nil
   if override and override.expires then
      if now < override.expires then
         override_target = override.target
      else
         override = nil
      end
   end
   local scheduled = time_valid and schedule.target_at(cfg.schedule, now) or nil
   local inputs = {
      rooms = snapshot.rooms,
      floors = snapshot.floors,
      water = snapshot.water,
      faults = snapshot.faults,
      warnings = snapshot.warnings,
      override_target = override_target,
      schedule_target = scheduled,
      mode = state.mode,
      manual_pump = manual_pump,
      force_off = service_mode or scan_mode,
   }
   state = controller.step(state, inputs, cfg, now)
   ssr_write(state.pump)
   publish_state_if_needed()
end

local sensor_worker = nil
local sensor_retry_at = 0
local sensor_stopping = false

local function sensor_worker_main()
   while not sensor_stopping do
      if not scan_requested and not scan_running then
         -- Never wrap yielding RMT calls in pcall; Xedge32 rejects yields
         -- across a C-call boundary.
         sensor_busy = true
         if service_mode and sensor_mgr:has_discovered() then
            sensor_mgr:read_service()
         else
            sensor_mgr:read_cycle()
         end
         sensor_busy = false
         local now = os.time()
         snapshot = sensor_mgr:snapshot(now)
         live_buf:record(snapshot, now)
      end
      ba.sleep(service_mode and 1000 or 10000)
   end
end

local function start_sensor_worker()
   sensor_worker = coroutine.create(sensor_worker_main)
   local ok, err = coroutine.resume(sensor_worker)
   if not ok then
      sensor_busy = false
      trace("thermostat: sensor worker error:", tostring(err))
   end
end

local function sensor_supervisor()
   while true do
      if not sensor_worker or "dead" == coroutine.status(sensor_worker) then
         local now = os.time()
         if now >= sensor_retry_at then
            sensor_retry_at = now + 10
            sensor_busy = false
            trace("thermostat: sensor worker restart")
            start_sensor_worker()
         end
      end
      coroutine.yield(true)
   end
end

local function scan_job()
   while scan_requested or scan_running do
      if scan_requested and not scan_running and not sensor_busy then
         scan_requested = false
         scan_running = true
         scan_started = os.time()
         scan_mode = true
         scan_result = nil
         apply_control()
         trace("thermostat: scan started")
         scan_result = sensor_mgr:scan_all()
         local now = os.time()
         snapshot = sensor_mgr:snapshot(now)
         live_buf:record(snapshot, now)
         scan_running = false
         scan_mode = false
         apply_control()
         trace("thermostat: scan done")
         return
      end
      coroutine.yield(true)
   end
end

local function start_scan_job()
   if scan_job_timer then
      return
   end
   scan_job_timer = ba.timer(function()
      scan_job_timer = nil
      scan_job()
   end)
   scan_job_timer:set(50)
end

local function room_history_sample()
   local s = build_state()
   if "number" ~= type(s.room) and "number" ~= type(s.floor) then
      return nil
   end
   return {
      t = s.time,
      room = s.room,
      floor = s.floor,
      target = s.target,
   }
end

local function pump_history_sample()
   local s = build_state()
   local sensors = {}
   for _, item in ipairs(snapshot.diagnostics or {}) do
      if "diag" == item.bus and item.ok and "number" == type(item.temp) then
         sensors[item.key] = item.temp
      end
   end
   if not next(sensors) then
      return nil
   end
   return {
      t = s.time,
      sensors = sensors,
      pump = s.pump and true or false,
   }
end

local function load_history()
   local ok, count = history_store.load(io, "history_room.jsonl", room_hist)
   if not ok then
      trace("thermostat: room history load:", tostring(count))
      count = 0
   end
   if count > room_hist.capacity
      or history_store.size(io, "history_room.jsonl") > (cfg.history.room.max_bytes or 163840) then
      local compacted, compact_err = history_store.compact(io, "history_room.jsonl", room_hist)
      if not compacted then
         trace("thermostat: room history compact:", tostring(compact_err))
      end
   end
   ok, count = history_store.load(io, "history_pump.jsonl", pump_hist)
   if not ok then
      trace("thermostat: pump history load:", tostring(count))
      count = 0
   end
   if count > pump_hist.capacity
      or history_store.size(io, "history_pump.jsonl") > (cfg.history.pump.max_bytes or 196608) then
      local compacted, compact_err = history_store.compact(io, "history_pump.jsonl", pump_hist)
      if not compacted then
         trace("thermostat: pump history compact:", tostring(compact_err))
      end
   end
end

local function record_history(kind, hist, item)
   local settings = cfg.history[kind]
   local name = "room" == kind and "history_room.jsonl" or "history_pump.jsonl"
   hist:add(item)
   local ok, err = history_store.append(io, name, item)
   if not ok then
      trace("thermostat: " .. kind .. " history append:", tostring(err))
   end
   if history_store.size(io, name) > (settings.max_bytes or 0) then
      local compacted, compact_err = history_store.compact(io, name, hist)
      if not compacted then
         trace("thermostat: " .. kind .. " history compact:", tostring(compact_err))
      end
   end
end

local function load_runtime()
   local ok, rwfile = pcall(require, "rwfile")
   if not ok then
      runtime.last_ms = ba.clock()
      return
   end
   local data = rwfile.json(io, "runtime.json")
   if "table" == type(data) and "number" == type(data.pump_seconds) then
      runtime.seconds = math.max(0, data.pump_seconds)
   end
   runtime.last_ms = ba.clock()
end

local function persist_runtime()
   local ok, rwfile = pcall(require, "rwfile")
   if not ok then
      return false, tostring(rwfile)
   end
   return rwfile.json(io, "runtime.json", {
      version = 1,
      pump_seconds = runtime.seconds,
   })
end

local function pump_meter_tick()
   local was = pump_meter_state
   runtime:update(ba.clock(), state.pump)
   pump_meter_state = state.pump
   local now = os.time()
   if (was and not state.pump) or (state.pump and now - last_runtime_persist >= 300) then
      last_runtime_persist = now
      persist_runtime()
   end
end

local function history_loop()
   while true do
      local now_ms = ba.clock()
      if history_next_room and now_ms >= history_next_room then
         local item = room_history_sample()
         if item then
            record_history("room", room_hist, item)
            history_next_room = now_ms + (cfg.history.room.sample_sec or 600) * 1000
         else
            history_next_room = now_ms + 10000
         end
      end
      if history_next_pump and now_ms >= history_next_pump then
         local item = pump_history_sample()
         if item then
            record_history("pump", pump_hist, item)
            history_next_pump = now_ms + (cfg.history.pump.sample_sec or 180) * 1000
         else
            history_next_pump = now_ms + 10000
         end
      end
      coroutine.yield(true)
   end
end

local function sanitized_config()
   local out = config.merge(cfg, {})
   out.mqtt.password = (cfg.mqtt.password and "" ~= cfg.mqtt.password) and "***" or ""
   out.wifi.sta_password_enc = (cfg.wifi.sta_password_enc and "" ~= cfg.wifi.sta_password_enc) and "***" or ""
   out.security = {
      pin_configured = pin_is_configured(),
      session_minutes = cfg.security.session_minutes or 30,
   }
   local list = {}
   for key, sensor in pairs(cfg.sensors or {}) do
      list[#list + 1] = {
         key = key,
         bus = sensor.bus,
         rom = sensor.rom,
         role = sensor.role,
         label = sensor.label,
         offset = sensor.offset,
      }
   end
   table.sort(list, function(a, b)
      return a.key < b.key
   end)
   out.sensor_list = list
   return out
end

function get_state()
   return build_state()
end

function get_live()
   return live_buf:list(os.time())
end

function format_utc_offset(minutes)
   return schedule.format_offset(minutes)
end

function parse_utc_offset(text)
   return schedule.parse_offset(text)
end

function offset_from_parts(hours, minutes)
   return schedule.offset_from_parts(hours, minutes)
end

function rounded_utc_offset(minutes)
   return schedule.round_offset(minutes)
end

function pin_configured()
   return pin_is_configured()
end

function pin_available()
   return pin_key ~= nil and ba ~= nil and ba.crypto ~= nil and ba.crypto.PBKDF2 ~= nil
end

function pin_trusted(peer, server)
   return pin_mod.is_trusted(peer, server)
end

function pin_check(pin)
   return pin_mod.verify(pin, cfg.security)
end

function pin_set(pin)
   if not pin_mod.validate(pin) then
      return false, "PIN должен состоять из 4 цифр."
   end
   cfg.security = cfg.security or {}
   local salt, err = pin_mod.random_salt()
   if not salt then
      return false, err
   end
   local hash
   hash, err = pin_mod.hash(pin, salt, cfg.security.pin_iterations or 20000)
   if not hash then
      return false, err
   end
   cfg.security.pin_salt = salt
   cfg.security.pin_hash = hash
   cfg.security.pin_iterations = cfg.security.pin_iterations or 20000
   local saved, save_err = config.save(io, cfg)
   if not saved then
      return false, save_err
   end
   pin_failures = {}
   return true
end

function pin_clear()
   cfg.security = cfg.security or {}
   cfg.security.pin_salt = ""
   cfg.security.pin_hash = ""
   local saved, err = config.save(io, cfg)
   if not saved then
      return false, err
   end
   pin_failures = {}
   return true
end

function pin_locked(ip)
   local entry = pin_failures[ip]
   if not entry then
      return false
   end
   if entry.locked_until and os.time() < entry.locked_until then
      return true, entry.locked_until - os.time()
   end
   if entry.locked_until then
      pin_failures[ip] = nil
   end
   return false
end

function pin_fail(ip)
   local entry = pin_failures[ip] or { count = 0 }
   entry.count = entry.count + 1
   if entry.count >= 5 then
      entry.count = 0
      entry.locked_until = os.time() + 300
   end
   pin_failures[ip] = entry
end

function pin_success(ip)
   pin_failures[ip] = nil
end

function pin_session_seconds()
   return (cfg.security.session_minutes or 30) * 60
end

function pin_token(request)
   if not pin_key then
      return nil
   end
   local ip = request:peername() or ""
   local ok, token = pcall(function()
      return ba.aesencode(pin_key, ba.json.encode({
         exp = os.time() + pin_session_seconds(),
         ip = ip,
      }))
   end)
   return ok and token or nil
end

function pin_valid(request)
   if not pin_is_configured() or not pin_key then
      return false
   end
   local cookie = request:cookie("thermo_pin")
   if not cookie then
      return false
   end
   local ok, data = pcall(ba.aesdecode, pin_key, cookie:value())
   if not ok or not data then
      return false
   end
   local decoded, item = pcall(ba.json.decode, data)
   if not decoded or "table" ~= type(item) or "number" ~= type(item.exp) then
      return false
   end
   if item.exp <= os.time() then
      return false
   end
   return item.ip == (request:peername() or "")
end

function csrf_token()
   if not csrf_key then
      return ""
   end
   local ok, token = pcall(function()
      return ba.aesencode(csrf_key, ba.json.encode({
         t = os.time(),
         n = ba.rnd and ba.rnd(0, 0x7FFFFFFF) or os.time(),
      }))
   end)
   return ok and token or ""
end

function csrf_valid(token)
   if not csrf_key or not token or "" == token then
      return false
   end
   local ok, data = pcall(ba.aesdecode, csrf_key, token)
   if not ok or not data then
      return false
   end
   local decoded, item = pcall(ba.json.decode, data)
   if not decoded or "table" ~= type(item) or "number" ~= type(item.t) then
      return false
   end
   local age = os.time() - item.t
   return age >= 0 and age <= 3600
end

function get_config()
   return sanitized_config()
end

function get_scan_result()
   return scan_result
end

function get_sensor_table()
   local now = os.time()
   local stale_after = cfg.control.stale_after_sec or 20
   local names = { "diag", "control_a", "control_b" }
   local buses = {}
   local by_name = {}
   for _, name in ipairs(names) do
      local entry = { name = name, pin = cfg.pins[name], sensors = {} }
      buses[#buses + 1] = entry
      by_name[name] = entry
   end

   local seen = {}
   local function add(bus, rom)
      local entry = by_name[bus]
      if not entry then
         return
      end
      rom = tostring(rom):upper()
      local key = bus .. ":" .. rom
      if seen[key] then
         return
      end
      seen[key] = true

      local sensor = cfg.sensors and cfg.sensors[key]
      local last = sensor_mgr.last[key]
      local discovered = sensor_mgr.discovered[bus]
      local present = nil
      if discovered then
         present = false
         for _, found in ipairs(discovered) do
            if tostring(found):upper() == rom then
               present = true
               break
            end
         end
      end

      local item = {
         key = key,
         bus = bus,
         rom = rom,
         role = sensor and sensor.role or nil,
         label = sensor and sensor.label or "",
         offset = sensor and sensor.offset or 0,
         assigned = sensor ~= nil,
         present = present,
         temp = last and last.temp or nil,
         delta = last and last.delta or nil,
         ts = last and last.ts or nil,
         ok = false,
         stale = true,
         err = last and last.err or (sensor and "not_read" or nil),
      }

      if present == false then
         item.err = "not_found"
      elseif last and last.ok and last.ts and (now - last.ts) <= stale_after then
         item.ok = true
         item.stale = false
         item.err = nil
      end

      entry.sensors[#entry.sensors + 1] = item
   end

   for _, name in ipairs(names) do
      for _, rom in ipairs(sensor_mgr.discovered[name] or {}) do
         add(name, rom)
      end
   end
   for _, sensor in pairs(cfg.sensors or {}) do
      add(sensor.bus, sensor.rom)
   end

   local max_delta = nil
   for _, entry in ipairs(buses) do
      table.sort(entry.sensors, function(a, b)
         return a.rom < b.rom
      end)
      for _, item in ipairs(entry.sensors) do
         if item.ok and "number" == type(item.delta) and item.delta > 0
            and (not max_delta or item.delta > max_delta) then
            max_delta = item.delta
         end
      end
   end
   if max_delta then
      for _, entry in ipairs(buses) do
         for _, item in ipairs(entry.sensors) do
            item.rise_top = item.ok and item.delta == max_delta
         end
      end
   end

   return {
      ok = true,
      service_mode = service_mode,
      scan_active = scan_mode or scan_requested or scan_running,
      buses = buses,
   }
end

function get_history(kind, range_sec)
   local hist = "pump" == kind and pump_hist or room_hist
   local items = hist:list()
   if range_sec then
      local cutoff = os.time() - range_sec
      local out = {}
      for _, item in ipairs(items) do
         if item.t and item.t >= cutoff then
            out[#out + 1] = item
         end
      end
      items = out
   end
   return hist:downsample(720)
end

function set_target(temp, hours, force)
   if not force and not cfg.ui.public_setpoint then
      return false, "public setpoint disabled"
   end
   temp = tonumber(temp)
   if not temp then
      return false, "invalid temperature"
   end
   if temp < cfg.ui.public_setpoint_min or temp > cfg.ui.public_setpoint_max then
      return false, "temperature out of range"
   end
   local now = os.time()
   if now - last_set_target < 2 then
      return false, "rate limited"
   end
   last_set_target = now
   local duration = tonumber(hours) or 2
   override = schedule.set_override(temp, os.time() + duration * 3600)
   apply_control()
   return true, temp
end

function clear_override()
   override = nil
   apply_control()
   return true, state.target
end

function set_mode(mode)
   if "auto" ~= mode and "off" ~= mode and "manual" ~= mode then
      return false, "invalid mode"
   end
   state.mode = mode
   if "manual" ~= mode then
      manual_pump = false
   end
   apply_control()
   return true, mode
end

function set_pump_test(on, seconds)
   if manual_timer then
      manual_timer:cancel()
      manual_timer = nil
   end
   state.mode = "manual"
   manual_pump = on and true or false
   if seconds and tonumber(seconds) then
      manual_timer = ba.timer(function()
         manual_pump = false
         state.mode = "auto"
         apply_control()
      end)
      manual_timer:set(tonumber(seconds) * 1000, true)
   end
   apply_control()
   return true, manual_pump
end

function scan_sensors()
   if scan_running then
      return { status = "running" }
   end
   if scan_requested then
      return { status = "queued" }
   end
   scan_requested = true
   scan_started = os.time()
   scan_result = nil
   scan_mode = true
   apply_control()
   start_scan_job()
   return { status = "queued" }
end

function scan_status()
   return {
      running = scan_running,
      requested = scan_requested,
      started = scan_started,
      sensor_busy = sensor_busy,
      service = service_mode,
      result = scan_result,
   }
end

function service_mode_enabled()
   return service_mode
end

function set_service_mode(on)
   local enabled = on and true or false
   service_mode = enabled
   apply_control()
   apply_led()
   if enabled then
      scan_sensors()
   end
   return true, enabled
end

function reset_pump_hours()
   if not service_mode then
      return false, "service mode required"
   end
   runtime:reset()
   local ok, err = persist_runtime()
   return ok, err
end

function assign_sensor(bus, rom, role, label, offset)
   if not service_mode then
      return false, "service mode required"
   end
   if not config.valid_role(role) then
      return false, "invalid role"
   end
   if "diag" ~= bus and "control_a" ~= bus and "control_b" ~= bus then
      return false, "invalid bus"
   end
   local newcfg = config.merge(cfg, {})
   config.set_sensor(newcfg, bus, rom, role, trim(label), tonumber(offset) or 0)
   local ok, errors = config.validate(newcfg)
   if not ok then
      return false, errors
   end
   local saved, err = config.save(io, newcfg)
   if not saved then
      return false, err
   end
   cfg = newcfg
   sensor_mgr.cfg = cfg
   return true
end

function remove_sensor(bus, rom)
   if not service_mode then
      return false, "service mode required"
   end
   local newcfg = config.merge(cfg, {})
   config.remove_sensor(newcfg, bus, rom)
   local ok, errors = config.validate(newcfg)
   if not ok then
      return false, errors
   end
   local saved, err = config.save(io, newcfg)
   if not saved then
      return false, err
   end
   cfg = newcfg
   sensor_mgr.cfg = cfg
   return true
end

function update_sensors(rows)
   if not service_mode then
      return false, "service mode required"
   end
   if "table" ~= type(rows) then
      return false, "rows must be a table"
   end
   local newcfg = config.merge(cfg, {})
   for _, row in ipairs(rows) do
      if "table" ~= type(row) then
         return false, "invalid row"
      end
      local bus = row.bus
      local rom = row.rom
      if not bus or not rom then
         return false, "invalid sensor"
      end
      if "diag" ~= bus and "control_a" ~= bus and "control_b" ~= bus then
         return false, "invalid bus"
      end
      rom = tostring(rom):upper()
      local role = row.role
      if not role or "" == role or "none" == role then
         config.remove_sensor(newcfg, bus, rom)
      else
         if not config.valid_role(role) then
            return false, "invalid role"
         end
         config.set_sensor(newcfg, bus, rom, role, trim(row.label), tonumber(row.offset) or 0)
      end
   end
   local ok, errors = config.validate(newcfg)
   if not ok then
      return false, errors
   end
   local saved, err = config.save(io, newcfg)
   if not saved then
      return false, err
   end
   cfg = newcfg
   sensor_mgr.cfg = cfg
   return true
end

local function cancel_wifi_switch()
   if wifi_switch_timer then
      cancel_timer(wifi_switch_timer)
      wifi_switch_timer = nil
   end
end

local function schedule_wifi_switch(delay_ms, fn)
   cancel_wifi_switch()
   wifi_switch_timer = ba.timer(function()
      wifi_switch_timer = nil
      fn()
   end)
   wifi_switch_timer:set(delay_ms)
end

local function save_wifi_config(wifi_patch)
   local newcfg = config.merge(cfg, { wifi = wifi_patch })
   local ok, errors = config.validate(newcfg)
   if not ok then
      return false, errors
   end
   local saved, err = config.save(io, newcfg)
   if not saved then
      return false, err
   end
   cfg = newcfg
   return true
end

local function start_sta(ssid, password)
   wifi_connect_deadline = os.time() + (cfg.wifi.connect_timeout_sec or 60)
   wifi_last_error = nil
   schedule_wifi_switch(2000, function()
      if esp32 and esp32.netconnect then
         local ok, err = pcall(esp32.netconnect, "wifi", { ssid = ssid, pwd = password })
         if not ok then
            wifi_last_error = tostring(err)
            trace("thermostat: wifi:", wifi_last_error)
         end
      end
   end)
end

function wifi_connect(ssid, password)
   ssid = trim(ssid)
   password = tostring(password or "")
   if "" == ssid then
      return false, "SSID не может быть пустым."
   end
   if "" == password then
      return false, "Пароль не может быть пустым."
   end
   local encrypted, err = encrypt_wifi_password(password)
   if not encrypted then
      return false, "Не удалось сохранить пароль: " .. tostring(err)
   end
   local ok, save_err = save_wifi_config({
      mode = "sta",
      sta_ssid = ssid,
      sta_password_enc = encrypted,
      connect_timeout_sec = cfg.wifi.connect_timeout_sec or 60,
   })
   if not ok then
      return false, save_err
   end
   start_sta(ssid, password)
   return true, { mode = "sta", ssid = ssid }
end

function wifi_use_saved()
   local wifi = cfg.wifi or {}
   if "" == (wifi.sta_ssid or "") or "" == (wifi.sta_password_enc or "") then
      return false, "Сохранённая сеть отсутствует."
   end
   local password, err = decrypt_wifi_password(wifi.sta_password_enc)
   if not password then
      return false, "Не удалось расшифровать пароль: " .. tostring(err)
   end
   local ok, save_err = save_wifi_config({
      mode = "sta",
      sta_ssid = wifi.sta_ssid,
      sta_password_enc = wifi.sta_password_enc,
      connect_timeout_sec = wifi.connect_timeout_sec or 60,
   })
   if not ok then
      return false, save_err
   end
   start_sta(wifi.sta_ssid, password)
   return true, { mode = "sta", ssid = wifi.sta_ssid }
end

function wifi_switch_ap()
   local ok, err = save_wifi_config({
      mode = "ap",
      sta_ssid = cfg.wifi.sta_ssid or "",
      sta_password_enc = cfg.wifi.sta_password_enc or "",
      connect_timeout_sec = cfg.wifi.connect_timeout_sec or 60,
   })
   if not ok then
      return false, err
   end
   wifi_connect_deadline = nil
   schedule_wifi_switch(2000, function()
      if "sta" == wifi_mode and esp32 and esp32.netconnect then
         local connected, conn_err = pcall(esp32.netconnect, "wifi")
         if not connected then
            wifi_last_error = tostring(conn_err)
            trace("thermostat: wifi ap:", wifi_last_error)
         end
      end
   end)
   return true
end

function wifi_forget()
   local ok, err = save_wifi_config({
      mode = "ap",
      sta_ssid = "",
      sta_password_enc = "",
      connect_timeout_sec = cfg.wifi.connect_timeout_sec or 60,
   })
   if not ok then
      return false, err
   end
   wifi_connect_deadline = nil
   schedule_wifi_switch(2000, function()
      if "sta" == wifi_mode and esp32 and esp32.netconnect then
         pcall(esp32.netconnect, "wifi")
      end
   end)
   return true
end

function wifi_note_client(peer)
   if "ap" == wifi_mode and peer and "" ~= tostring(peer) then
      wifi_ap_client_seen = os.time()
   end
end

function wifi_scan()
   if not (esp32 and esp32.wscan) then
      return nil, "Сканирование Wi-Fi недоступно."
   end
   local ok, result = pcall(esp32.wscan)
   if not ok then
      return nil, tostring(result)
   end
   local list = {}
   for _, item in ipairs(result or {}) do
      if item.ssid and "" ~= item.ssid then
         list[#list + 1] = item
      end
   end
   table.sort(list, function(a, b)
      return (tonumber(a.rssi) or -999) > (tonumber(b.rssi) or -999)
   end)
   return list
end

local function apply_wifi_config()
   local wifi = cfg.wifi or {}
   if "ap" == wifi.mode then
      schedule_wifi_switch(1500, function()
         if "sta" == wifi_mode and esp32 and esp32.netconnect then
            pcall(esp32.netconnect, "wifi")
         end
      end)
      return
   end
   if "sta" ~= wifi.mode then
      return
   end
   if "" == (wifi.sta_ssid or "") or "" == (wifi.sta_password_enc or "") then
      trace("thermostat: wifi: saved STA credentials are missing")
      wifi_switch_ap()
      return
   end
   local password, err = decrypt_wifi_password(wifi.sta_password_enc)
   if not password then
      trace("thermostat: wifi: cannot decrypt STA password:", tostring(err))
      wifi_switch_ap()
      return
   end
   start_sta(wifi.sta_ssid, password)
end

local function restart_mqtt()
   if mqtt_bridge then
      mqtt_bridge:stop()
      mqtt_bridge = nil
   end
   local base_topic = (cfg.mqtt.base_topic or "home/floor/thermostat") .. "/"
   local bridge, err = mqtt_mod.new(cfg, {
      on_connect = function(b)
         b:publish_discovery(build_state(), node_id())
         b:publish_state(build_state())
      end,
      on_command = function(topic, data)
         if topic == base_topic .. "set/target" then
            local value = "table" == type(data) and data.value or data
            set_target(value, nil, true)
         elseif topic == base_topic .. "set/mode" then
            local value = "table" == type(data) and data.value or data
            if "heat" == value then
               set_mode("auto")
            elseif "off" == value then
               set_mode("off")
            end
         end
      end,
   })
   if bridge then
      mqtt_bridge = bridge
      local ok, err = bridge:start()
      if not ok then
         trace("thermostat: mqtt:", tostring(err))
      end
   elseif err and "disabled" ~= err then
      trace("thermostat: mqtt:", tostring(err))
   end
end

function update_config(patch)
   if "table" ~= type(patch) then
      return false, "config must be a table"
   end
   if patch.mqtt and "***" == patch.mqtt.password then
      patch.mqtt.password = cfg.mqtt.password
   end
   local merged = config.merge(cfg, patch)
   local ok, errors = config.validate(merged)
   if not ok then
      return false, errors
   end
   cfg = merged
   local saved, err = config.save(io, cfg)
   if not saved then
      return false, err
   end
   sensor_mgr.cfg = cfg
   restart_mqtt()
   apply_control()
   return true, { restart_required = false }
end

function reload_config()
   local newcfg, ok, err = config.load(io)
   if not ok then
      return false, err
   end
   cfg = newcfg
   sensor_mgr.cfg = cfg
   restart_mqtt()
   apply_control()
   return true
end

function onunload()
   sensor_stopping = true
   sensor_busy = false
   service_mode = false
   scan_mode = false
   runtime:update(ba.clock(), state.pump)
   persist_runtime()
   ssr_write(false)
   cancel_timer(sensor_timer)
   cancel_timer(control_timer)
   cancel_timer(scan_job_timer)
   cancel_timer(history_timer)
   cancel_timer(led_timer)
   cancel_timer(manual_timer)
   cancel_wifi_switch()
   if mqtt_bridge then
      mqtt_bridge:stop()
   end
   if rgb then
      rgb:off()
      rgb:close()
   end
   if ssr then
      ssr:close()
   end
end

if xedge and xedge.event then
   xedge.event("sntp", function()
      time_valid = true
      apply_control()
   end)
   xedge.event("wifi", function(status, mode)
      if "ap" == mode or "sta" == mode then
         if wifi_mode ~= mode then
            wifi_ap_client_seen = nil
         end
         wifi_mode = mode
      end
      wifi_connected = (status == "up")
      if "sta" == wifi_mode then
         wifi_sta_connected = (status == "up")
         if wifi_sta_connected then
            wifi_connect_deadline = nil
            wifi_last_error = nil
         end
      elseif "ap" == wifi_mode then
         wifi_sta_connected = false
         if "ap" == (cfg.wifi.mode or "auto") then
            wifi_connect_deadline = nil
         end
      end
      if "up" ~= status and "down" ~= status then
         wifi_last_error = tostring(status)
      end
      apply_led()
   end)
   xedge.event("wip", function(ip)
      wifi_ip = ip
   end)
   xedge.event("error", function(msg)
      ssr_write(false)
      trace("thermostat: Lua error, pump off:", tostring(msg))
   end)
end

load_history()
load_runtime()
pump_meter_state = state.pump
history_next_room = ba.clock() + 1000
history_next_pump = ba.clock() + 1000
restart_mqtt()
apply_wifi_config()

-- Xedge timers stop when the callback returns. Repeating work must yield.
local function control_loop()
   while true do
      if wifi_connect_deadline and not wifi_sta_connected and os.time() >= wifi_connect_deadline then
         wifi_connect_deadline = nil
         wifi_last_error = "STA connection timeout"
         trace("thermostat: wifi: STA timeout, switching to AP")
         wifi_switch_ap()
      end
      if (scan_running or scan_requested) and (os.time() - scan_started) > 20 then
         scan_running = false
         scan_requested = false
         scan_mode = false
         if scan_job_timer then
            cancel_timer(scan_job_timer)
            scan_job_timer = nil
         end
         scan_result = { buses = {}, errors = { "Сканирование не завершилось за 20 секунд." } }
      end
      apply_control()
      pump_meter_tick()
      coroutine.yield(true)
   end
end

local function led_loop()
   while true do
      led_tick = led_tick + 1
      apply_led()
      coroutine.yield(true)
   end
end

sensor_timer = ba.timer(sensor_supervisor)
sensor_timer:set(1000)
start_sensor_worker()

control_timer = ba.timer(control_loop)
control_timer:set(1000)

history_timer = ba.timer(history_loop)
history_timer:set(1000)

led_timer = ba.timer(led_loop)
led_timer:set(100)

apply_led()

trace("thermostat: started, control_ready=" .. tostring(config.control_ready(cfg)))
