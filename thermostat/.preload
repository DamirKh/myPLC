xedge.createloader(io)

local config = require("modules.config")
local ds = require("modules.ds18b20")
local sensor_manager = require("modules.sensor_manager")
local controller = require("modules.controller")
local schedule = require("modules.schedule")
local history_mod = require("modules.history")
local mqtt_mod = require("modules.mqtt_bridge")
local rgb_led = require("modules.rgb_led")
local indicator = require("modules.indicator")
local pin_mod = require("modules.pin")

local cfg, loaded, load_err = config.load(io)
if not loaded then
   trace("thermostat: config load:", tostring(load_err))
end

local pin_key
if ba and ba.aeskey then
   local ok, key = pcall(ba.aeskey, 32)
   if ok then
      pin_key = key
   end
end

local csrf_key
if ba and ba.aeskey then
   local ok, key = pcall(ba.aeskey, 32)
   if ok then
      csrf_key = key
   end
end

local wifi_tpm_key
local function wifi_crypto_key()
   if wifi_tpm_key then
      return wifi_tpm_key
   end
   if not (ba and ba.tpm and ba.tpm.uniquekey) then
      return nil, "softTPM unavailable"
   end
   local ok, key = pcall(ba.tpm.uniquekey, "thermostat-wifi", 32)
   if not ok or not key then
      return nil, tostring(key)
   end
   wifi_tpm_key = key
   return key
end

local function encrypt_wifi_password(password)
   local key, err = wifi_crypto_key()
   if not key then
      return nil, err
   end
   local ok, value = pcall(ba.aesencode, key, password)
   if not ok or not value then
      return nil, tostring(value)
   end
   return value
end

local function decrypt_wifi_password(value)
   local key, err = wifi_crypto_key()
   if not key then
      return nil, err
   end
   local ok, password = pcall(ba.aesdecode, key, value)
   if not ok or not password then
      return nil, tostring(password)
   end
   return password
end

local pin_failures = {}

local function pin_is_configured()
   return cfg.security and cfg.security.pin_hash and "" ~= cfg.security.pin_hash
end

local ssr
local function ssr_write(on)
   if not ssr then
      return
   end
   local active_high = cfg.pins.ssr_active_high ~= false
   ssr:value(active_high and on or not on)
end

if esp32 and esp32.gpio then
   ssr = esp32.gpio(cfg.pins.ssr, "OUT")
   ssr_write(false)
end

local rgb
if cfg.pins.rgb_enabled ~= false then
   rgb = rgb_led.new(cfg.pins.rgb, { brightness = cfg.pins.rgb_brightness })
   if not rgb then
      trace("thermostat: rgb led unavailable")
   end
end

local sensor_mgr = sensor_manager.new(cfg)
local state = controller.new(cfg, os.time())
local hist = history_mod.new(math.floor(((cfg.history.ram_hours or 48) * 3600) / (cfg.history.sample_sec or 60)))
local snapshot = sensor_mgr:snapshot(os.time())
local override = nil
local manual_pump = false
local manual_timer = nil
local service_mode = false
local scan_requested = false
local scan_running = false
local scan_started = 0
local scan_result = nil
local sensor_busy = false
local wifi_connected = false
local wifi_sta_connected = false
local wifi_mode = nil
local wifi_ip = nil
local wifi_ap_client_seen = nil
local wifi_connect_deadline = nil
local wifi_switch_timer = nil
local wifi_last_error = nil
local led_tick = 0
local boot_until = os.time() + 2
local time_valid = os.time() > 1600000000
local mqtt_bridge = nil
local last_mqtt_publish = 0
local last_history_persist = 0
local last_set_target = 0
local history_pending = {}

local function max_value(t)
   local v = t[1]
   for i = 2, #t do
      if t[i] > v then
         v = t[i]
      end
   end
   return v
end

local function avg_value(t)
   if #t == 0 then
      return nil
   end
   local sum = 0
   for _, v in ipairs(t) do
      sum = sum + v
   end
   return sum / #t
end

local function role_temp(snap, role)
   local values = {}
   for _, item in ipairs(snap.diagnostics or {}) do
      if item.ok and item.role == role then
         values[#values + 1] = item.temp
      end
   end
   return avg_value(values)
end

local function node_id()
   if esp32 and esp32.mac then
      local mac = esp32.mac()
      return "xedge32_" .. (mac:gsub(".", function(c)
         return string.format("%02x", string.byte(c))
      end))
   end
   return "xedge32_thermostat"
end

local function build_state()
   local ready = config.control_ready(cfg)
   return {
      ok = true,
      ready = ready,
      pump = state.pump,
      mode = state.mode,
      target = state.target,
      base_target = cfg.control.target_room,
      setpoint_min = cfg.ui.public_setpoint_min,
      setpoint_max = cfg.ui.public_setpoint_max,
      override_active = override ~= nil and override.expires ~= nil and override.expires > os.time(),
      override_until = (override and override.expires and override.expires > os.time()) and override.expires or nil,
      floor_limit = cfg.control.floor_limit,
      room = avg_value(snapshot.rooms),
      floor = (#snapshot.floors > 0) and max_value(snapshot.floors) or nil,
      supply = role_temp(snapshot, "supply"),
      return_temp = role_temp(snapshot, "return"),
      pump_temp = role_temp(snapshot, "pump"),
      faults = state.faults,
      warnings = state.warnings,
      sensors = snapshot.diagnostics,
      time = os.time(),
      time_valid = time_valid,
      utc_offset_minutes = cfg.schedule.utc_offset_minutes or 0,
      schedule_enabled = cfg.schedule.enabled,
      frost_enabled = cfg.control.frost_enabled,
      mqtt_enabled = cfg.mqtt.enabled,
      mqtt_connected = mqtt_bridge and mqtt_bridge.connected or false,
      wifi = wifi_connected,
      wifi_mode = wifi_mode,
      wifi_sta_connected = wifi_sta_connected,
      wifi_ip = wifi_ip,
      wifi_sta_ssid = cfg.wifi.sta_ssid or "",
      wifi_has_credentials = "" ~= (cfg.wifi.sta_ssid or "") and "" ~= (cfg.wifi.sta_password_enc or ""),
      wifi_ap_client_active = "ap" == wifi_mode and wifi_ap_client_seen ~= nil
         and (os.time() - wifi_ap_client_seen) < 30,
      wifi_last_error = wifi_last_error,
      led_tick = led_tick,
      pin_configured = pin_is_configured(),
      pin_available = pin_key ~= nil,
      service_mode = service_mode,
      last_reason = state.last_reason,
   }
end

local function publish_state_if_needed(force)
   if not mqtt_bridge or not mqtt_bridge.connected then
      return
   end
   local now = os.time()
   if force or now - last_mqtt_publish >= 30 then
      last_mqtt_publish = now
      mqtt_bridge:publish_state(build_state())
   end
end

local function apply_led()
   if not rgb then
      return
   end
   local color = indicator.frame({
      boot = os.time() < boot_until,
      fault = #state.faults > 0,
      service = service_mode,
      wifi = wifi_connected,
      wifi_mode = wifi_mode,
      wifi_sta_connected = wifi_sta_connected,
      wifi_ap_client_active = "ap" == wifi_mode and wifi_ap_client_seen ~= nil
         and (os.time() - wifi_ap_client_seen) < 30,
      pump = state.pump,
   }, led_tick)
   rgb:write(color)
end

local function apply_control()
   local now = os.time()
   time_valid = now > 1600000000
   local override_target = nil
   if override and override.expires then
      if now < override.expires then
         override_target = override.target
      else
         override = nil
      end
   end
   local scheduled = time_valid and schedule.target_at(cfg.schedule, now) or nil
   local inputs = {
      rooms = snapshot.rooms,
      floors = snapshot.floors,
      water = snapshot.water,
      faults = snapshot.faults,
      warnings = snapshot.warnings,
      override_target = override_target,
      schedule_target = scheduled,
      mode = state.mode,
      manual_pump = manual_pump,
      force_off = service_mode,
   }
   state = controller.step(state, inputs, cfg, now)
   ssr_write(state.pump)
   publish_state_if_needed()
end

local function sensor_loop()
   while true do
      if not service_mode and not scan_requested and not scan_running then
         -- Never wrap yielding RMT calls in pcall; Xedge32 rejects yields
         -- across a C-call boundary.
         sensor_busy = true
         sensor_mgr:read_cycle()
         sensor_busy = false
         snapshot = sensor_mgr:snapshot(os.time())
      end
      coroutine.yield(true)
   end
end

local function scan_loop()
   while true do
      if scan_requested and not scan_running and not sensor_busy then
         scan_requested = false
         scan_running = true
         scan_started = os.time()
         service_mode = true
         scan_result = nil
         apply_control()
         scan_result = sensor_mgr:scan_all()
         scan_running = false
         service_mode = false
         snapshot = sensor_mgr:snapshot(os.time())
         apply_control()
      end
      coroutine.yield(true)
   end
end

local function history_sample()
   local s = build_state()
   return {
      t = s.time,
      room = s.room,
      floor = s.floor,
      supply = s.supply,
      return_temp = s.return_temp,
      pump = s.pump,
      target = s.target,
   }
end

local function load_history()
   local ok, rwfile = pcall(require, "rwfile")
   if not ok then
      return
   end
   local data = rwfile.file(io, "history.jsonl")
   if not data then
      return
   end
   for line in data:gmatch("[^\r\n]+") do
      local item = history_mod.decode(line)
      if item then
         hist:add(item)
      end
   end
end

local function persist_history()
   local ok, rwfile = pcall(require, "rwfile")
   if not ok then
      return
   end
   if 0 == #history_pending then
      return
   end
   local old = rwfile.file(io, "history.jsonl") or ""
   local add = table.concat(history_pending, "\n") .. "\n"
   history_pending = {}
   local data = old .. add
   if #data > (cfg.history.max_bytes or 1048576) then
      data = data:sub(-(cfg.history.max_bytes or 1048576))
      local nl = data:find("\n")
      if nl then
         data = data:sub(nl + 1)
      end
   end
   rwfile.file(io, "history.jsonl", data)
end

local function history_tick()
   local sample = history_sample()
   hist:add(sample)
   local line = history_mod.encode(sample)
   if line then
      history_pending[#history_pending + 1] = line
   end
   local now = os.time()
   if now - last_history_persist >= (cfg.history.flash_sample_sec or 300) then
      last_history_persist = now
      persist_history()
   end
end

local function sanitized_config()
   local out = config.merge(cfg, {})
   out.mqtt.password = (cfg.mqtt.password and "" ~= cfg.mqtt.password) and "***" or ""
   out.wifi.sta_password_enc = (cfg.wifi.sta_password_enc and "" ~= cfg.wifi.sta_password_enc) and "***" or ""
   out.security = {
      pin_configured = pin_is_configured(),
      session_minutes = cfg.security.session_minutes or 30,
   }
   local list = {}
   for key, sensor in pairs(cfg.sensors or {}) do
      list[#list + 1] = {
         key = key,
         bus = sensor.bus,
         rom = sensor.rom,
         role = sensor.role,
         label = sensor.label,
         offset = sensor.offset,
      }
   end
   table.sort(list, function(a, b)
      return a.key < b.key
   end)
   out.sensor_list = list
   return out
end

function get_state()
   return build_state()
end

function format_utc_offset(minutes)
   return schedule.format_offset(minutes)
end

function parse_utc_offset(text)
   return schedule.parse_offset(text)
end

function rounded_utc_offset(minutes)
   return schedule.round_offset(minutes)
end

function pin_configured()
   return pin_is_configured()
end

function pin_available()
   return pin_key ~= nil and ba ~= nil and ba.crypto ~= nil and ba.crypto.PBKDF2 ~= nil
end

function pin_trusted(peer, server)
   return pin_mod.is_trusted(peer, server)
end

function pin_check(pin)
   return pin_mod.verify(pin, cfg.security)
end

function pin_set(pin)
   if not pin_mod.validate(pin) then
      return false, "PIN должен состоять из 4 цифр."
   end
   cfg.security = cfg.security or {}
   local salt, err = pin_mod.random_salt()
   if not salt then
      return false, err
   end
   local hash
   hash, err = pin_mod.hash(pin, salt, cfg.security.pin_iterations or 20000)
   if not hash then
      return false, err
   end
   cfg.security.pin_salt = salt
   cfg.security.pin_hash = hash
   cfg.security.pin_iterations = cfg.security.pin_iterations or 20000
   local saved, save_err = config.save(io, cfg)
   if not saved then
      return false, save_err
   end
   pin_failures = {}
   return true
end

function pin_clear()
   cfg.security = cfg.security or {}
   cfg.security.pin_salt = ""
   cfg.security.pin_hash = ""
   local saved, err = config.save(io, cfg)
   if not saved then
      return false, err
   end
   pin_failures = {}
   return true
end

function pin_locked(ip)
   local entry = pin_failures[ip]
   if not entry then
      return false
   end
   if entry.locked_until and os.time() < entry.locked_until then
      return true, entry.locked_until - os.time()
   end
   if entry.locked_until then
      pin_failures[ip] = nil
   end
   return false
end

function pin_fail(ip)
   local entry = pin_failures[ip] or { count = 0 }
   entry.count = entry.count + 1
   if entry.count >= 5 then
      entry.count = 0
      entry.locked_until = os.time() + 300
   end
   pin_failures[ip] = entry
end

function pin_success(ip)
   pin_failures[ip] = nil
end

function pin_session_seconds()
   return (cfg.security.session_minutes or 30) * 60
end

function pin_token(request)
   if not pin_key then
      return nil
   end
   local ip = request:peername() or ""
   local ok, token = pcall(function()
      return ba.aesencode(pin_key, ba.json.encode({
         exp = os.time() + pin_session_seconds(),
         ip = ip,
      }))
   end)
   return ok and token or nil
end

function pin_valid(request)
   if not pin_is_configured() or not pin_key then
      return false
   end
   local cookie = request:cookie("thermo_pin")
   if not cookie then
      return false
   end
   local ok, data = pcall(ba.aesdecode, pin_key, cookie:value())
   if not ok or not data then
      return false
   end
   local decoded, item = pcall(ba.json.decode, data)
   if not decoded or "table" ~= type(item) or "number" ~= type(item.exp) then
      return false
   end
   if item.exp <= os.time() then
      return false
   end
   return item.ip == (request:peername() or "")
end

function csrf_token()
   if not csrf_key then
      return ""
   end
   local ok, token = pcall(function()
      return ba.aesencode(csrf_key, ba.json.encode({
         t = os.time(),
         n = ba.rnd and ba.rnd(0, 0x7FFFFFFF) or os.time(),
      }))
   end)
   return ok and token or ""
end

function csrf_valid(token)
   if not csrf_key or not token or "" == token then
      return false
   end
   local ok, data = pcall(ba.aesdecode, csrf_key, token)
   if not ok or not data then
      return false
   end
   local decoded, item = pcall(ba.json.decode, data)
   if not decoded or "table" ~= type(item) or "number" ~= type(item.t) then
      return false
   end
   local age = os.time() - item.t
   return age >= 0 and age <= 3600
end

function get_config()
   return sanitized_config()
end

function get_scan_result()
   return scan_result
end

function get_history(range_sec)
   local items = hist:list()
   if range_sec then
      local cutoff = os.time() - range_sec
      local out = {}
      for _, item in ipairs(items) do
         if item.t and item.t >= cutoff then
            out[#out + 1] = item
         end
      end
      items = out
   end
   return hist:downsample(720)
end

function set_target(temp, hours, force)
   if not force and not cfg.ui.public_setpoint then
      return false, "public setpoint disabled"
   end
   temp = tonumber(temp)
   if not temp then
      return false, "invalid temperature"
   end
   if temp < cfg.ui.public_setpoint_min or temp > cfg.ui.public_setpoint_max then
      return false, "temperature out of range"
   end
   local now = os.time()
   if now - last_set_target < 2 then
      return false, "rate limited"
   end
   last_set_target = now
   local duration = tonumber(hours) or 2
   override = schedule.set_override(temp, os.time() + duration * 3600)
   apply_control()
   return true, temp
end

function clear_override()
   override = nil
   apply_control()
   return true, state.target
end

function set_mode(mode)
   if "auto" ~= mode and "off" ~= mode and "manual" ~= mode then
      return false, "invalid mode"
   end
   state.mode = mode
   if "manual" ~= mode then
      manual_pump = false
   end
   apply_control()
   return true, mode
end

function set_pump_test(on, seconds)
   if manual_timer then
      manual_timer:cancel()
      manual_timer = nil
   end
   state.mode = "manual"
   manual_pump = on and true or false
   if seconds and tonumber(seconds) then
      manual_timer = ba.timer(function()
         manual_pump = false
         state.mode = "auto"
         apply_control()
      end)
      manual_timer:set(tonumber(seconds) * 1000, true)
   end
   apply_control()
   return true, manual_pump
end

function scan_sensors()
   if scan_running then
      return { status = "running" }
   end
   if scan_requested then
      return { status = "queued" }
   end
   scan_requested = true
   scan_result = nil
   service_mode = true
   apply_control()
   return { status = "queued" }
end

function scan_status()
   return {
      running = scan_running,
      requested = scan_requested,
      result = scan_result,
   }
end

function assign_sensor(bus, rom, role, label, offset)
   if not config.valid_role(role) then
      return false, "invalid role"
   end
   if "diag" ~= bus and "control_a" ~= bus and "control_b" ~= bus then
      return false, "invalid bus"
   end
   config.set_sensor(cfg, bus, rom, role, label, offset)
   local ok, errors = config.validate(cfg)
   if not ok then
      return false, errors
   end
   local saved, err = config.save(io, cfg)
   if not saved then
      return false, err
   end
   sensor_mgr.cfg = cfg
   return true
end

function remove_sensor(bus, rom)
   config.remove_sensor(cfg, bus, rom)
   local ok, errors = config.validate(cfg)
   if not ok then
      return false, errors
   end
   local saved, err = config.save(io, cfg)
   if not saved then
      return false, err
   end
   sensor_mgr.cfg = cfg
   return true
end

local function trim(text)
   return tostring(text or ""):match("^%s*(.-)%s*$")
end

local function cancel_wifi_switch()
   if wifi_switch_timer then
      wifi_switch_timer:cancel()
      wifi_switch_timer = nil
   end
end

local function schedule_wifi_switch(delay_ms, fn)
   cancel_wifi_switch()
   wifi_switch_timer = ba.timer(function()
      wifi_switch_timer = nil
      fn()
   end)
   wifi_switch_timer:set(delay_ms)
end

local function save_wifi_config(wifi_patch)
   local newcfg = config.merge(cfg, { wifi = wifi_patch })
   local ok, errors = config.validate(newcfg)
   if not ok then
      return false, errors
   end
   local saved, err = config.save(io, newcfg)
   if not saved then
      return false, err
   end
   cfg = newcfg
   return true
end

local function start_sta(ssid, password)
   wifi_connect_deadline = os.time() + (cfg.wifi.connect_timeout_sec or 60)
   wifi_last_error = nil
   schedule_wifi_switch(2000, function()
      if esp32 and esp32.netconnect then
         local ok, err = pcall(esp32.netconnect, "wifi", { ssid = ssid, pwd = password })
         if not ok then
            wifi_last_error = tostring(err)
            trace("thermostat: wifi:", wifi_last_error)
         end
      end
   end)
end

function wifi_connect(ssid, password)
   ssid = trim(ssid)
   password = tostring(password or "")
   if "" == ssid then
      return false, "SSID не может быть пустым."
   end
   if "" == password then
      return false, "Пароль не может быть пустым."
   end
   local encrypted, err = encrypt_wifi_password(password)
   if not encrypted then
      return false, "Не удалось сохранить пароль: " .. tostring(err)
   end
   local ok, save_err = save_wifi_config({
      mode = "sta",
      sta_ssid = ssid,
      sta_password_enc = encrypted,
      connect_timeout_sec = cfg.wifi.connect_timeout_sec or 60,
   })
   if not ok then
      return false, save_err
   end
   start_sta(ssid, password)
   return true, { mode = "sta", ssid = ssid }
end

function wifi_use_saved()
   local wifi = cfg.wifi or {}
   if "" == (wifi.sta_ssid or "") or "" == (wifi.sta_password_enc or "") then
      return false, "Сохранённая сеть отсутствует."
   end
   local password, err = decrypt_wifi_password(wifi.sta_password_enc)
   if not password then
      return false, "Не удалось расшифровать пароль: " .. tostring(err)
   end
   local ok, save_err = save_wifi_config({
      mode = "sta",
      sta_ssid = wifi.sta_ssid,
      sta_password_enc = wifi.sta_password_enc,
      connect_timeout_sec = wifi.connect_timeout_sec or 60,
   })
   if not ok then
      return false, save_err
   end
   start_sta(wifi.sta_ssid, password)
   return true, { mode = "sta", ssid = wifi.sta_ssid }
end

function wifi_switch_ap()
   local ok, err = save_wifi_config({
      mode = "ap",
      sta_ssid = cfg.wifi.sta_ssid or "",
      sta_password_enc = cfg.wifi.sta_password_enc or "",
      connect_timeout_sec = cfg.wifi.connect_timeout_sec or 60,
   })
   if not ok then
      return false, err
   end
   wifi_connect_deadline = nil
   schedule_wifi_switch(2000, function()
      if "sta" == wifi_mode and esp32 and esp32.netconnect then
         local connected, conn_err = pcall(esp32.netconnect, "wifi")
         if not connected then
            wifi_last_error = tostring(conn_err)
            trace("thermostat: wifi ap:", wifi_last_error)
         end
      end
   end)
   return true
end

function wifi_forget()
   local ok, err = save_wifi_config({
      mode = "ap",
      sta_ssid = "",
      sta_password_enc = "",
      connect_timeout_sec = cfg.wifi.connect_timeout_sec or 60,
   })
   if not ok then
      return false, err
   end
   wifi_connect_deadline = nil
   schedule_wifi_switch(2000, function()
      if "sta" == wifi_mode and esp32 and esp32.netconnect then
         pcall(esp32.netconnect, "wifi")
      end
   end)
   return true
end

function wifi_note_client(peer)
   if "ap" == wifi_mode and peer and "" ~= tostring(peer) then
      wifi_ap_client_seen = os.time()
   end
end

function wifi_scan()
   if not (esp32 and esp32.wscan) then
      return nil, "Сканирование Wi-Fi недоступно."
   end
   local ok, result = pcall(esp32.wscan)
   if not ok then
      return nil, tostring(result)
   end
   local list = {}
   for _, item in ipairs(result or {}) do
      if item.ssid and "" ~= item.ssid then
         list[#list + 1] = item
      end
   end
   table.sort(list, function(a, b)
      return (tonumber(a.rssi) or -999) > (tonumber(b.rssi) or -999)
   end)
   return list
end

local function apply_wifi_config()
   local wifi = cfg.wifi or {}
   if "ap" == wifi.mode then
      schedule_wifi_switch(1500, function()
         if "sta" == wifi_mode and esp32 and esp32.netconnect then
            pcall(esp32.netconnect, "wifi")
         end
      end)
      return
   end
   if "sta" ~= wifi.mode then
      return
   end
   if "" == (wifi.sta_ssid or "") or "" == (wifi.sta_password_enc or "") then
      trace("thermostat: wifi: saved STA credentials are missing")
      wifi_switch_ap()
      return
   end
   local password, err = decrypt_wifi_password(wifi.sta_password_enc)
   if not password then
      trace("thermostat: wifi: cannot decrypt STA password:", tostring(err))
      wifi_switch_ap()
      return
   end
   start_sta(wifi.sta_ssid, password)
end

local function restart_mqtt()
   if mqtt_bridge then
      mqtt_bridge:stop()
      mqtt_bridge = nil
   end
   local base_topic = (cfg.mqtt.base_topic or "home/floor/thermostat") .. "/"
   local bridge, err = mqtt_mod.new(cfg, {
      on_connect = function(b)
         b:publish_discovery(build_state(), node_id())
         b:publish_state(build_state())
      end,
      on_command = function(topic, data)
         if topic == base_topic .. "set/target" then
            local value = "table" == type(data) and data.value or data
            set_target(value, nil, true)
         elseif topic == base_topic .. "set/mode" then
            local value = "table" == type(data) and data.value or data
            if "heat" == value then
               set_mode("auto")
            elseif "off" == value then
               set_mode("off")
            end
         end
      end,
   })
   if bridge then
      mqtt_bridge = bridge
      local ok, err = bridge:start()
      if not ok then
         trace("thermostat: mqtt:", tostring(err))
      end
   elseif err and "disabled" ~= err then
      trace("thermostat: mqtt:", tostring(err))
   end
end

function update_config(patch)
   if "table" ~= type(patch) then
      return false, "config must be a table"
   end
   if patch.mqtt and "***" == patch.mqtt.password then
      patch.mqtt.password = cfg.mqtt.password
   end
   local merged = config.merge(cfg, patch)
   local ok, errors = config.validate(merged)
   if not ok then
      return false, errors
   end
   cfg = merged
   local saved, err = config.save(io, cfg)
   if not saved then
      return false, err
   end
   sensor_mgr.cfg = cfg
   restart_mqtt()
   apply_control()
   return true, { restart_required = false }
end

function reload_config()
   local newcfg, ok, err = config.load(io)
   if not ok then
      return false, err
   end
   cfg = newcfg
   sensor_mgr.cfg = cfg
   restart_mqtt()
   apply_control()
   return true
end

function onunload()
   ssr_write(false)
   if sensor_timer then
      sensor_timer:cancel()
   end
   if control_timer then
      control_timer:cancel()
   end
   if scan_timer then
      scan_timer:cancel()
   end
   if history_timer then
      history_timer:cancel()
   end
   if led_timer then
      led_timer:cancel()
   end
   if manual_timer then
      manual_timer:cancel()
   end
   cancel_wifi_switch()
   if mqtt_bridge then
      mqtt_bridge:stop()
   end
   if rgb then
      rgb:off()
      rgb:close()
   end
   if ssr then
      ssr:close()
   end
end

if xedge and xedge.event then
   xedge.event("sntp", function()
      time_valid = true
      apply_control()
   end)
   xedge.event("wifi", function(status, mode)
      if "ap" == mode or "sta" == mode then
         if wifi_mode ~= mode then
            wifi_ap_client_seen = nil
         end
         wifi_mode = mode
      end
      wifi_connected = (status == "up")
      if "sta" == wifi_mode then
         wifi_sta_connected = (status == "up")
         if wifi_sta_connected then
            wifi_connect_deadline = nil
            wifi_last_error = nil
         end
      elseif "ap" == wifi_mode then
         wifi_sta_connected = false
         if "ap" == (cfg.wifi.mode or "auto") then
            wifi_connect_deadline = nil
         end
      end
      if "up" ~= status and "down" ~= status then
         wifi_last_error = tostring(status)
      end
      apply_led()
   end)
   xedge.event("wip", function(ip)
      wifi_ip = ip
   end)
   xedge.event("error", function(msg)
      ssr_write(false)
      trace("thermostat: Lua error, pump off:", tostring(msg))
   end)
end

load_history()
restart_mqtt()
apply_wifi_config()

-- Xedge timers stop when the callback returns. Repeating work must yield.
local function control_loop()
   while true do
      if wifi_connect_deadline and not wifi_sta_connected and os.time() >= wifi_connect_deadline then
         wifi_connect_deadline = nil
         wifi_last_error = "STA connection timeout"
         trace("thermostat: wifi: STA timeout, switching to AP")
         wifi_switch_ap()
      end
      if scan_running and (os.time() - scan_started) > 20 then
         scan_running = false
         scan_requested = false
         service_mode = false
         scan_result = { buses = {}, errors = { "Сканирование не завершилось за 20 секунд." } }
      end
      apply_control()
      coroutine.yield(true)
   end
end

local function history_loop()
   while true do
      history_tick()
      coroutine.yield(true)
   end
end

local function led_loop()
   while true do
      led_tick = led_tick + 1
      apply_led()
      coroutine.yield(true)
   end
end

sensor_timer = ba.timer(sensor_loop)
sensor_timer:set(10000)

scan_timer = ba.timer(scan_loop)
scan_timer:set(500)

control_timer = ba.timer(control_loop)
control_timer:set(1000)

history_timer = ba.timer(history_loop)
history_timer:set((cfg.history.sample_sec or 60) * 1000)

led_timer = ba.timer(led_loop)
led_timer:set(100)

apply_led()

trace("thermostat: started, control_ready=" .. tostring(config.control_ready(cfg)))
